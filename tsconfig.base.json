{
	"compilerOptions": {
		"target": "ES2024",
		"module": "ESNext",
		"lib": ["ES2024", "DOM.AsyncIterable"],
		"moduleResolution": "Bundler",
		"moduleDetection": "force",
		"strict": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,
		"allowArbitraryExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"paths": {
			"@dude1wudv/pi-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@dude1wudv/pi-coding-agent/*": ["./packages/coding-agent/src/*"],
			"@dude1wudv/pi-utils": ["./packages/utils/src/index.ts"],
			"@dude1wudv/pi-utils/*": ["./packages/utils/src/*"]
		},
		"types": ["bun", "assets"],
		"typeRoots": ["./types", "./node_modules/@types"]
	}
}
